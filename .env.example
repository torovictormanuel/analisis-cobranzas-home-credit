# Copia este archivo como .env y completa los valores
# NUNCA subas el .env al repositorio

# URL de conexion a Supabase (Pooler — para Python/SQLAlchemy)
# Formato: postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=postgresql://postgres.TU_PROJECT_ID:TU_PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Ruta local donde están los CSV raw de Kaggle
DATA_PATH=C:\ruta\a\home-credit-default-risk

# Cantidad de filas a cargar por tabla (default: 50000)
N_FILAS=50000
